# EmailJS Configuration
# Get these from https://dashboard.emailjs.com after creating an account
NEXT_PUBLIC_EMAILJS_SERVICE_ID=YOUR_EMAILJS_SERVICE_ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=YOUR_EMAILJS_TEMPLATE_ID

# EmailJS Private Key (Account > API Keys). Server-only - sent as accessToken so
# EmailJS accepts API calls from server environments (fixes HTTP 403 "API access
# from non-browser environments is currently disabled"). Keep the To field of
# your EmailJS templates set to {{customer_email}}.
EMAILJS_PRIVATE_KEY=

# Admin dashboard password used by /admin and /api/admin/* (server-only)
# Use "hairluxe-demo" for demo mode, or set your own secure password
ADMIN_PASSWORD=hairluxe-demo

# Supabase Postgres database URL for persisting orders and bookings
# Get this from your Supabase project settings (DATABASE_URL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.supabase.co:5432/postgres

# Also update the PUBLIC_KEY value in src/lib/config.ts if needed
# PUBLIC_KEY is already set to "GeLrfdQC6goeir_m2"

# Business email shown across the site (contact page, footer).
# PLACEHOLDER - set the real business email before going live.
NEXT_PUBLIC_BUSINESS_EMAIL=hello@hairluxe.example.com

# Social links shown in the footer and contact page.
NEXT_PUBLIC_WHATSAPP=https://wa.me/2348123456789
NEXT_PUBLIC_WHATSAPP_PHONE=+234 812 345 6789
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_INSTAGRAM=

# Canonical / sitemap origin (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://hairluxe-zootodev.vercel.app